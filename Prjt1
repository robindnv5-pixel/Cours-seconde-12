<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mes révisions</title>
<style>

:root{
  --rojo:#c60b1e; --amarillo:#ffc400; --ink:#2b2b2b; --card:#ffffff; --bg:#fdf6e3;
  --muted:#6b6b6b; --ok:#1e8e3e; --bad:#d23f31; --border:#eadfb8;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){ --ink:#f0e9d8; --card:#2a2620; --bg:#1c1913; --muted:#b8b0a0; --border:#443c28; }
}
:root[data-theme="dark"]{ --ink:#f0e9d8; --card:#2a2620; --bg:#1c1913; --muted:#b8b0a0; --border:#443c28; }
*{box-sizing:border-box;}
html{scroll-padding-top:env(safe-area-inset-top,0px);}
body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;line-height:1.4;min-height:100%;}
header{background:linear-gradient(135deg,var(--rojo),var(--amarillo));padding:22px 16px 26px;text-align:center;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.25);}
header h1{margin:0;font-size:1.5rem;}
header p{margin:6px 0 0;font-size:.9rem;opacity:.95;}
main{max-width:520px;margin:0 auto;padding:16px 16px 40px;}
.card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px;box-shadow:0 1px 3px rgba(0,0,0,.06);}
label{display:block;font-weight:600;margin:14px 0 6px;font-size:.9rem;}
input[type=text],select{width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--ink);font-size:1rem;}
.opts{display:flex;flex-direction:column;gap:8px;margin-top:6px;}
.opt{padding:10px 12px;border:1px solid var(--border);border-radius:8px;cursor:pointer;background:transparent;color:var(--ink);text-align:left;font-size:.95rem;}
.opt.selected{border-color:var(--rojo);background:rgba(198,11,30,.08);}
.opt.correct{border-color:var(--ok);background:rgba(30,142,62,.12);}
.opt.wrong{border-color:var(--bad);background:rgba(210,63,49,.12);}
button.big{display:block;width:100%;padding:14px;background:var(--rojo);color:#fff;border:none;border-radius:12px;font-size:1.05rem;font-weight:700;cursor:pointer;margin-top:16px;}
button.big:disabled{opacity:.5;}
button.ghost{background:transparent;color:var(--rojo);border:2px solid var(--rojo);}
.progress{height:8px;background:var(--border);border-radius:6px;overflow:hidden;margin-bottom:14px;}
.progress>div{height:100%;background:var(--rojo);width:0%;transition:width .3s;}
.qcount{font-size:.8rem;color:var(--muted);margin-bottom:6px;}
.feedback{margin-top:10px;font-weight:600;font-size:.9rem;}
.feedback.ok{color:var(--ok);} .feedback.bad{color:var(--bad);}
.hidden{display:none;}
.scorebig{font-size:2.6rem;font-weight:800;color:var(--rojo);text-align:center;}
.msg{text-align:center;margin:6px 0 16px;}
.podium{display:flex;align-items:flex-end;justify-content:center;gap:10px;margin:18px 0;}
.pod{background:linear-gradient(180deg,var(--amarillo),var(--rojo));border-radius:8px 8px 0 0;color:#fff;text-align:center;padding:8px 6px;font-weight:700;font-size:.8rem;}
.pod .name{display:block;font-size:.85rem;margin-bottom:4px;}
.pod1{height:100px;order:2;width:33%;} .pod2{height:75px;order:1;width:30%;} .pod3{height:55px;order:3;width:30%;}
ul.rank{list-style:none;padding:0;margin:10px 0;}
ul.rank li{display:flex;justify-content:space-between;padding:8px 10px;border-bottom:1px solid var(--border);font-size:.9rem;}
.note{font-size:.78rem;color:var(--muted);text-align:center;margin-top:8px;}

.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.sub{background:var(--card);border:2px solid var(--border);border-radius:14px;padding:18px 8px;font-size:1rem;font-weight:700;color:var(--ink);cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:6px}
.sub .em{font-size:2rem}.sub small{font-weight:400;color:var(--muted)}
.sub:disabled{opacity:.45;cursor:not-allowed}
.back{background:none;border:none;color:var(--rojo);font-weight:700;font-size:.95rem;padding:0 0 10px;cursor:pointer}
.ch{margin-bottom:12px}.row{display:flex;gap:8px;margin-top:10px}
.small{flex:1;padding:10px;border-radius:10px;border:2px solid var(--rojo);background:transparent;color:var(--rojo);font-weight:700;cursor:pointer}
.course h2{margin-top:0}.course ul{padding-left:18px}.course li{margin:6px 0}
.key{background:rgba(255,196,0,.25);border-left:4px solid var(--amarillo);padding:8px 10px;border-radius:6px;font-weight:700}
.q{font-weight:600;margin-bottom:8px}
h2{font-size:1.15rem;margin:4px 0 12px}
.course table{width:100%;border-collapse:collapse;font-size:.88rem;margin:8px 0}
.course td{border-bottom:1px solid var(--border);padding:5px 6px;vertical-align:top}
</style>
</head>
<body>
<header><h1>📚 Mes révisions</h1><p id="tagline">Choisis une matière</p></header>
<main>
<div id="homeScreen" class="screen"><div class="grid" id="homeGrid"></div></div>

<div id="subjScreen" class="screen hidden"><button class="back" onclick="home()">← Menu</button><h2 id="subjTitle"></h2><div id="chList"></div></div>

<div id="courseScreen" class="screen card hidden"><button class="back" onclick="openSubj(curSi)">← Chapitres</button><div id="courseBody" class="course"></div><button class="big" onclick="openSetup(curCi)">📝 Faire le test</button></div>

<div id="setupScreen" class="screen card hidden">
  <button class="back" onclick="openSubj(curSi)">← Chapitres</button>
  <h2 id="setupTitle"></h2>
  <label>Ton prénom</label><input type="text" id="nameInput" placeholder="Ton prénom...">
  <label>Nombre de questions</label><select id="countInput"></select>
  <button class="big" onclick="startQuiz()">Commencer le test 🚀</button>
</div>

<div id="quizScreen" class="screen card hidden">
  <div class="qcount" id="qcount"></div>
  <div class="progress"><div id="progBar"></div></div>
  <div id="qBody"></div>
  <button class="big" id="actionBtn"></button>
  <button class="back" style="margin-top:12px" onclick="openSubj(curSi)">✕ Quitter</button>
</div>

<div id="resultScreen" class="screen card hidden">
  <div class="scorebig" id="scoreNum"></div>
  <div class="msg" id="scoreMsg"></div>
  <div id="weakAreas"></div>
  <h3>🏆 Classement</h3>
  <div class="podium" id="podium"></div>
  <ul class="rank" id="rankList"></ul>
  <div class="note">Classement enregistré sur cet appareil.</div>
  <button class="big" onclick="openSetup(curCi)">🔁 Refaire le test</button>
  <button class="big ghost" id="courseBtn" onclick="openCourse(curCi)">📖 Relire le cours</button>
  <button class="big ghost" onclick="home()">🏠 Menu principal</button>
</div>
</main>
