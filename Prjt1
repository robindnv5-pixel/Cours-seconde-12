function renderQ(){
  validated=false;chosen=null;const q=quiz[idx];
  $('qcount').textContent='Question '+(idx+1)+' / '+quiz.length+'  ·  '+CATNAMES[q.cat];
  $('progBar').style.width=(idx/quiz.length*100)+'%';
  let h='<div class="q">'+fmt(q.q)+'</div>';
  if(q.kind==='choice'){
    const o=q.opts.map((_,i)=>i);if(!q.fix)shuffle(o);
    h+='<div class="opts">'+o.map(i=>'<button class="opt" data-i="'+i+'" onclick="pick('+i+')">'+fmt(q.opts[i])+'</button>').join('')+'</div>';
  } else h+='<input type="text" id="txtAns" placeholder="ta réponse..." autocomplete="off" autocapitalize="off">';
  $('qBody').innerHTML=h+'<div class="feedback" id="fb"></div>';
  const b=$('actionBtn');b.textContent='Valider';b.disabled=(q.kind==='choice');b.onclick=validate;
  if(q.kind==='text'){$('txtAns').addEventListener('keyup',e=>{if(e.key==='Enter')validate();});setTimeout(()=>$('txtAns').focus(),50);}
}
function pick(i){
  if(validated)return;chosen=i;
  document.querySelectorAll('.opt').forEach(b=>b.classList.toggle('selected',+b.dataset.i===i));
  $('actionBtn').disabled=false;
}
function validate(){
  const q=quiz[idx];
  if(validated){idx++;if(idx>=quiz.length)finish();else renderQ();return;}
  let ok,exp;
  if(q.kind==='choice'){
    if(chosen===null)return;
    ok=chosen===q.ans;exp=q.opts[q.ans];
    document.querySelectorAll('.opt').forEach(b=>{const i=+b.dataset.i;if(i===q.ans)b.classList.add('correct');else if(i===chosen)b.classList.add('wrong');});
  } else {
    const v=norm($('txtAns').value);ok=v.length>0&&q.ans.map(norm).includes(v);exp=q.ans[0];
  }
  const fb=$('fb');fb.className='feedback '+(ok?'ok':'bad');
  fb.innerHTML=ok?'✔ Correct !':'✘ Réponse attendue : '+fmt(exp);
  if(ok)score++;else wrongCats[q.cat]=(wrongCats[q.cat]||0)+1;
  validated=true;
  $('actionBtn').textContent=(idx===quiz.length-1)?'Voir mon résultat':'Suivant →';
}
function finish(){
  show('resultScreen');
  const n=Math.round(score/quiz.length*20);
  $('scoreNum').textContent=n+' / 20';
  $('scoreMsg').textContent=n>=17?"¡Excelente! "+playerName+", c'est très bien acquis.":n>=13?"Bon travail, "+playerName+" — quelques révisions à faire.":n>=8?"Pas mal, mais plusieurs points sont à revoir.":"Il faut reprendre le chapitre, "+playerName+".";
  const e=Object.entries(wrongCats).sort((a,b)=>b[1]-a[1]);
  $('weakAreas').innerHTML=e.length?'<p class="msg"><b>À revoir en priorité :</b></p><ul class="rank">'+e.map(([c,k])=>'<li><span>'+CATNAMES[c]+'</span><span>'+k+' erreur(s)</span></li>').join('')+'</ul>':'<p class="msg">Aucune erreur, bravo ! 🎉</p>';
  $('courseBtn').style.display=SUBJ[curSi].ch[curCi].c?'block':'none';
  const k='lb_'+SUBJ[curSi].ch[curCi].id;let l=[];
  try{l=JSON.parse(localStorage.getItem(k)||'[]');}catch(x){}
  const r=l.find(x=>norm(x.name)===norm(playerName));
  if(r)r.best=Math.max(r.best,n);else l.push({name:playerName,best:n});
  l.sort((a,b)=>b.best-a.best);
  try{localStorage.setItem(k,JSON.stringify(l));}catch(x){}
  l=l.slice(0,20);const p=[l[1],l[0],l[2]],cl=['pod2','pod1','pod3'];
  $('podium').innerHTML=p.map((r,i)=>r?'<div class="pod '+cl[i]+'"><span class="name">'+esc(r.name)+'</span>'+r.best+'/20</div>':'').join('');
  $('rankList').innerHTML=l.map((r,i)=>'<li><span>'+(i+1)+'. '+esc(r.name)+'</span><span>'+r.best+'/20</span></li>').join('');
}
home();
</script>
</body>
</html>
